# Copier vers ansible/inventory.ini (gitignoré : détails réseau internes).
#
# L'IP de l'hôte Proxmox est statique (`/etc/network/interfaces`), elle ne bouge
# pas d'elle-même. Si elle changeait malgré tout, il faudrait la mettre à jour ici
# aux trois endroits : `ansible_host` du groupe [proxmox], et les deux ProxyJump
# ci-dessous.

[proxmox]
proxmox-host ansible_host=192.168.1.253 ansible_user=root

[k3s]
k3s-host ansible_host=10.10.10.50 ansible_user=debian ansible_ssh_common_args='-o ProxyJump=root@192.168.1.253 -o StrictHostKeyChecking=accept-new'

[pokemon_find]
pokemon-find-host ansible_host=10.10.10.52 ansible_user=debian ansible_ssh_common_args='-o ProxyJump=root@192.168.1.253 -o StrictHostKeyChecking=accept-new'
